{
  "name": "@horizonsuite/api-documentation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "generate": "node scripts/generate-openapi.mjs",
    "lint": "npm run generate && redocly lint generated/api.json generated/auth.json",
    "test": "npm run generate && node --test tests/*.test.mjs",
    "build": "npm run clean && npm run generate && node scripts/build.mjs",
    "check": "npm run lint && npm test && npm run build",
    "serve": "node scripts/serve.mjs"
  },
  "dependencies": {
    "swagger-ui-dist": "5.33.1"
  },
  "devDependencies": {
    "@redocly/cli": "2.60.0",
    "protobufjs": "8.8.0"
  }
}
